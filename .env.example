# TiMi Configuration
# Copy this file to .env and fill in your actual values

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Exchange API Keys
# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here
BINANCE_TESTNET=true  # Set to false for production

# CME (if using)
CME_API_KEY=your_cme_api_key_here
CME_API_SECRET=your_cme_secret_here

# Database
DATABASE_URL=sqlite:///./timi.db

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_MONITORING=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/timi.log

# Safety Settings
# Boolean values are case insensitive: true/True/TRUE/1/yes/on and
# false/False/0/no/off all work, and surrounding spaces are ignored. A value
# that cannot be read at all resolves towards safety (paper trading, testnet)
# and logs a warning.
MAX_TOTAL_CAPITAL=10000  # Maximum total capital to deploy
MAX_POSITION_SIZE=1000   # Maximum single position size
EMERGENCY_STOP=false     # Emergency stop all trading
PAPER_TRADING_MODE=true  # Start in paper trading mode

# Live trading unlock. Live trading needs BOTH of these, and neither alone is
# enough: TIMI_ALLOW_LIVE=1 here, and the flag --i-understand-the-risk on the
# command line. Leave this unset (or at 0) unless you mean to risk real money.
TIMI_ALLOW_LIVE=0

# Alerts (optional)
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
